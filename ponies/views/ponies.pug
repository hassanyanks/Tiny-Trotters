extends layout 

block content
    if ponies.length 
        div.resources-container 
            each pony in ponies
                div.resource-container 
                    h2  #{pony.name}
                    if pony.image.length && pony.image.length > 0
                        each picture in pony.image
                            img.img-our-ponies(src="/images/" + picture)
