extends layout 

block content
    div.resources-container 
        if eventTypes.length && eventTypes.length > 0
            div.resource-container
                h2.standard-underline Event Types & Services
                ul.centered-list
                    each eventType in eventTypes
                        li  #{eventType.name}
        if accessories.length && accessories.length > 0
            div.resource-container  
                h2.standard-underline Pony Accessories
                ul.centered-list
                    each accessory in accessories
                        li  #{accessory.name}
        //div.resource-container  
            h2.standard-underline Other  
            ul.centered-list
                li Pony Rides (65 lb weight limit)
                li Photo Shoots  
        div.resource-container  
            h2.standard-underline Prices  
            ul.centered-list
                li Ponies
                    ul 
                        li One:  $250/hr
                        li Multiple: $325/hr  
                li Accessories
                    ul 
                        li First 3:  free 
                        li Additional:  $25 each  
                li Discounts 
                    ul 
                        li Active Military/Veteran: 10%
