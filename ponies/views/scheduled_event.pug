extends layout 

block content
    div.standard-underline(style="align-self: center; margin-bottom: 20px;")
        h2(style="margin-bottom: 10px;") Event Scheduled Pending Confirmation Callback
    div(style="margin-bottom: 20px;").service-portal
        button.submit-button(type="submit" style="align-self: center;") 
            a(href='/sign-waiver') Sign Waiver
    div.grid-container
        div.fields-container
            h3.standard-underline Event Details
            each [fieldName,fieldValue] of Object.entries(eventDetails)
                if fieldName && fieldValue
                    div.field.styled-border
                        span(style="font-weight: bold; margin: 10px;") #{fieldName}:  
                        span(style="margin: 10px 10px 10px 3px;") #{fieldValue}
        div.fields-container
            h3.standard-underline Pony Details
            each pony in Object.keys(ponyAccessoriesData)
                if pony
                    div.field.styled-border
                        h4(style="margin-left: 5px;") #{pony} #{JSON.stringify(ponyRolesData[pony])}
                        ul 
                            li Role
                                each [key,val] of Object.entries(ponyRolesData).filter(([key]) => key.includes(pony))
                                    ul 
                                        li #{val}
                        ul 
                            li Accessories
                                if ponyAccessoriesData[pony].accessories && ponyAccessoriesData[pony].accessories.length > 0
                                    each accessory in ponyAccessoriesData[pony].accessories.flat() 
                                        ul 
                                            li #{accessory}

