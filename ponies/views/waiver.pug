extends layout 

block content
    form(action="/waiver", method='POST')
        input(type="hidden", name="eventDetails", value=JSON.stringify(details))
        div(style="width: 100%").waiver-container
            h3.standard-underline Read waiver, then ensure all fields have the necessary data
            h4(style="font-style: italic; margin-top: 5px; margin-bottom: 0px;") Later--in person--you will sign a copy of the waiver being sent to us 
            h5(style="font-style: italic;  color: red; margin-top: 5px;") We are also emailing you a copy  
            iframe(src=`/templates/${waiverForm}` id="waiver-form-iframe" width="100%" height="300px")
            label(for="customerName") Your Full Name
            input(type="text" id="customerName" name="customerName" value=details.yourDetails['Your-Name'] size=50 required)
            label(for="customerPhone") Your Phone
            input(type="text" id="customerPhone" name="customerPhone" value=details.yourDetails['Your-Phone'] size=25 required)
            label(for="customerAddress") Your Address
            input(type="text" id="customerAddress" name="customerAddress" value=details.yourDetails['Your-Full-Address'] size=100 required)

            if details.eventDetails['Event-Location'] === 'Another Venue'
                hr
                label(for="venueContactName") Venue Contact Name
                input(type="text" id="venueContactName" name="venueContactName" value=details.venueDetails['Venue-Contact-Name'] size=50 required)
                label(for="venuePhone") Venue Phone
                input(type="text" id="venuePhone" name="venuePhone" value=details.venueDetails['Venue-Phone'] size=25)
                label(for="venueAddress") Venue Address
                input(type="text" id="venueAddress" name="venueAddress" value=details.venueDetails['Venue-Full-Address'] size=100 required)

            hr
            label(for="customerChildData") Names and Ages of Children to be Present
            textarea(id="customerChildData" name="customerChildData" rows="5" style="width: 25%;" required)
        div.buttons-container
            button.submit-button#sign-submit-btn(type="submit")
                span Submit
            a.cancel-button(href='/index') Cancel
            //FOLLOWING ELEMENTS' DISPLAY IS SET TO 'NONE' UNTIL WE START USING THE ELECTRONIC SIGNING FEATURE
            //label(style="display: none;") Draw Your Signature Below   eventMongoDbId
            //div(style="display: none;").signature-wrapper
                div.signature-container
                    canvas.signature-canvas
                div(style="display: flex; flex-direction: column;")
                    button.submit-button#sign-submit-btn(style="margin-top: 10px; max-width: 250px;") Submit/Download PDF
                    button(style="align-self: center;").cancel-button#sig-clear-btn Clear Canvas
