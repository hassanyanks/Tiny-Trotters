extends layout 

block content
    form(action="/waiver-done", method='POST')
        input(type="hidden", name="eventMongoDbId", value=eventMongoDbId)
        input(type="hidden", name="eventLocation", value=eventLocation)
        input(type="hidden", name="customerEmail", value=customerEmail)
        div(style="width: 100%").waiver-container
            h2.standard-underline Read waiver and fill in fields/correct any pre-filled data
            h3(style="font-style: italic;") Later--in person--you will sign a copy of the waiver being sent to us 
            iframe(src=`/templates/${process.env.WAIVER_FORM}` id="waiver-form-iframe" width="100%" height="300px")
            label(for="customerName") Your Full Name
            input(type="text" id="customerName" name="customerName" value=customerName size=50 required)
            label(for="customerPhone") Your Phone
            input(type="text" id="customerPhone" name="customerPhone" value=customerPhone size=25 required)
            label(for="customerAddress") Your Address
            input(type="text" id="customerAddress" name="customerAddress" value=`${customerAddress}` size=100 required)

            if eventLocation === 'Another Venue'
                hr
                label(for="venueName") Venue Name
                input(type="text" id="venueName" name="venueName" value=venueName size=50 required)
                label(for="venuePhone") Venue Phone
                input(type="text" id="venuePhone" name="venuePhone" value=venuePhone size=25)
                label(for="venueAddress") Venue Address
                input(type="text" id="venueAddress" name="venueAddress" value=`${venueAddress}` size=100 required)

            hr
            label(for="customerPhone") Names and Ages of Children to be Present
            textarea(type="text" id="customerChildData" name="customerChildData" rows="5" style="width: 25%;" required)
        div.buttons-container
            button.submit-button#sig-submit-btn(type="submit")
                span Submit
            a.cancel-button(href='/index') Cancel
            //FOLLOWING ELEMENTS' DISPLAY IS SET TO 'NONE' UNTIL WE START USING THE ELECTRONIC SIGNING FEATURE
            //label(style="display: none;") Draw Your Signature Below   eventMongoDbId
            //div(style="display: none;").signature-wrapper
                div.signature-container
                    canvas.signature-canvas
                div(style="display: flex; flex-direction: column;")
                    button.submit-button#sig-submit-btn(style="margin-top: 10px; max-width: 250px;") Submit/Download PDF
                    button(style="align-self: center;").cancel-button#sig-clear-btn Clear Canvas
