doctype html
html
  head
    link(rel='stylesheet', href='/stylesheets/style.css')
    block scripts 
  body
    div.page-container
      header.navbar 
        div.nav-left.nav-side
          a(href='/index'): img(src="/images/tiny_trotters_home.png" alt="Home")
        div.nav-center
          h1.standard-underline Tiny Trotters Pony Parties
          h2 Miniature Horses for Hire
          h5.standard-underline Serving #{citiesServed}
        div.nav-right.nav-side
          a(href='/index') Home
          if isAuthenticated
            form(action="/logout" method="POST")
              button.submit-button Log Out
          else
            form(action="/login" method="GET")
              button.submit-button Log In
      hr.layout-hr
      block content
    footer.sticky-footer
      p
        span Sydney Radford | 385-309-9979 |
        span
          a(href="mailto:tinytrottersponyparties@gmail.com") tinytrottersponyparties@gmail.com
      p.socials
        span
          a(href=`https://www.facebook.com/profile.php?id=${process.env.FACEBOOK_ID}` target="_blank")
            img(src="/images/icon-logo-facebook.png" alt="Facebook")
        span
          a(href="https://www.instagram.com/tiny_trotters_pony_parties/" target="_blank")
            img(src="/images/icon-logo-instagram.png" alt="Instagram")
        span
          img.qr-code(src='/images/recolored_qr.svg')
        span
          img(src="/images/vet_owned_biz.png", alt="Vet Owned")

