extends layout 

block content
    h2.standard-underline Schedule Event
    form.grid-container(action="/request_form", method='GET', target="_blank")
        div.field
            label Event Type
            select.responsive-input.custom-select(required name="event" id="event-type-select")
                if events && events.length > 0
                    option(value="" disabled selected id="event-type-placeholder") Choose an option...
                    each event in events
                        option(value=event.id)= event.name
            input#other-event-type(type="text")
            label(id="event-type-reset-label" style="font-size: 14px; display: none") Reset
            input(id="event-type-reset-box" type="checkbox" style="display: none")
        div.field
            label Event Accessories
            select.responsive-input(title="Select up to 3 (Ctrl + Click selects/de-selects)" id="accessories-select" name="accessories" multiple size="5")
                if accessories && accessories.length > 0
                    each accessory in accessories
                        option(value=accessory.id)= accessory.name
            label#other-accessory-label(style="font-size: 14px; display: none") Other Accessory
            input#other-accessory(type="text")
            label(id="other-accessory-reset-label" style="font-size: 14px; display: none") Reset
            input(id="other-accessory-reset-box" type="checkbox" style="display: none")
            label(style="font-size: 14px") Clear All Accessories
            input(id="clear-accessories" type="checkbox")
        div.field 
            label Event Start
            input.responsive-input(type="datetime-local") 
            label Event End 
            input.responsive-input(type="datetime-local")
        div.field.full-width 
            label Event Address 
            input.responsive-text-input(type="text", maxlength="200") 
        div.field.full-width 
            label Contact Details
            input.responsive-text-input(type="text", maxlength="100") 
        div.field.full-width
            button(type="submit") Submit
    script(src="../javascripts/formHelpers.js")
