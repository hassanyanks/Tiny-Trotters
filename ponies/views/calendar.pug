extends layout 

block scripts 
    script(src="/javascripts/calendarListeners.js", type="module")
block content
    div.calendar-container
        .calendar-header
            button#prevBtn.nav-btn &#10094;
            h2#monthLabel Loading...
            button#nextBtn.nav-btn &#10095; 
        .weekday-row
            each day in ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']
                .weekday-label= day
        .slider-viewport#viewport
