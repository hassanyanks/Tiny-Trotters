extends layout 

block scripts 
    script(src="/javascripts/calendarListeners.js", type="module")
block content
    div.calendar-container
        div.header 
            button#previous-month-button ◀ Prev
            h2#month-header
            button#next-month-button Next ▶
        div.weekdays
            div Sun 
            div Mon 
            div Tue 
            div Wed 
            div Thu 
            div Fri 
            div Sat 
        div.grid#calendar-grid
        div.popover#event-popover

    //- Dimming Backdrop (Closes panel when clicked)
    div.overlay-backdrop#panel-backdrop

    //- Slide Over Side Expander
    div.side-expander#expander-panel
        div.expander-header
            h1#expander-title Event
            button#close-expander ✕
        div.expander-content
            div.event-meta
